<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/txtEdited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="4dp"
        android:text="edited"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/receiverMsgContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtEdited"
        android:layout_alignParentStart="true"
        android:gravity="start"
        android:orientation="vertical">

        <EditText
            android:id="@+id/receiverText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/receiver_bg"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:inputType="textMultiLine"
            android:maxWidth="280dp"
            android:padding="12dp"
            android:text="Receiver Message"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/optionsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/outline_content_copy_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/receiverTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/receiverMsgContainer"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:text="12:00 PM"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10sp" />
</RelativeLayout>