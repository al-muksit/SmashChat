<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When the field is 'checked' (Password Visible), show eye_close -->
    <item android:drawable="@drawable/eye_close" android:state_checked="true" />

    <!-- Default state (Password Hidden), show eye_open -->
    <item android:drawable="@drawable/eye_open" />
</selector>